#pragma version 11
#pragma typetrack false

// test_cases.bytes_ops.contract.BiguintBinaryOps.approval_program() -> uint64:
main:
    bytecblock 0x05 0xff 0x0f 0x
    b main_block@0

main_block@0:
    // bytes_ops/contract.py:6
    // left=Bytes.from_hex("FF"),
    bytec_1 // 0xff
    // bytes_ops/contract.py:7
    // right=Bytes.from_hex("0F"),
    bytec_2 // 0x0f
    // bytes_ops/contract.py:8
    // concat=Bytes.from_hex("FF0F"),
    pushbytes 0xff0f
    // bytes_ops/contract.py:9
    // bitwise_or=Bytes.from_hex("FF"),
    bytec_1 // 0xff
    // bytes_ops/contract.py:10
    // bitwise_xor=Bytes.from_hex("F0"),
    pushbytes 0xf0
    // bytes_ops/contract.py:11
    // bitwise_and=Bytes.from_hex("0F"),
    bytec_2 // 0x0f
    // bytes_ops/contract.py:5-12
    // do_some_ops(
    //     left=Bytes.from_hex("FF"),
    //     right=Bytes.from_hex("0F"),
    //     concat=Bytes.from_hex("FF0F"),
    //     bitwise_or=Bytes.from_hex("FF"),
    //     bitwise_xor=Bytes.from_hex("F0"),
    //     bitwise_and=Bytes.from_hex("0F"),
    // )
    callsub do_some_ops
    // bytes_ops/contract.py:13
    // do_augmented_assignment_ops(Bytes.from_hex("FF"))
    bytec_1 // 0xff
    callsub do_augmented_assignment_ops
    // bytes_ops/contract.py:14
    // do_byteops_with_structs(Point(UInt64(1), UInt64(2)),
    pushint 1
    itob
    bytec_3 // 0x
    uncover 1
    concat
    pushint 2
    itob
    concat
    // bytes_ops/contract.py:15
    // Point(UInt64(3), UInt64(4)))
    pushint 3
    itob
    bytec_3 // 0x
    uncover 1
    concat
    pushint 4
    itob
    concat
    // bytes_ops/contract.py:14-15
    // do_byteops_with_structs(Point(UInt64(1), UInt64(2)),
    //                         Point(UInt64(3), UInt64(4)))
    callsub do_byteops_with_structs
    cover 1
    // bytes_ops/contract.py:16
    // return True
    pushint 1
    return


// test_cases.bytes_ops.contract.do_some_ops(left: bytes, right: bytes, concat: bytes, bitwise_or: bytes, bitwise_xor: bytes, bitwise_and: bytes) -> void:
do_some_ops:
    // bytes_ops/contract.py:22-31
    // @subroutine
    // def do_some_ops(
    //     *,
    //     left: Bytes,
    //     right: Bytes,
    //     concat: Bytes,
    //     bitwise_or: Bytes,
    //     bitwise_xor: Bytes,
    //     bitwise_and: Bytes,
    // ) -> None:
    proto 6 0
    b do_some_ops_block@0

do_some_ops_block@0:
    // bytes_ops/contract.py:32
    // result = left + right
    frame_dig -6
    frame_dig -5
    concat
    // bytes_ops/contract.py:33
    // assert result == concat
    frame_dig -4
    ==
    assert
    // bytes_ops/contract.py:34
    // result = left | right
    frame_dig -6
    frame_dig -5
    b|
    // bytes_ops/contract.py:35
    // assert result == bitwise_or
    frame_dig -3
    ==
    assert
    // bytes_ops/contract.py:36
    // result = left ^ right
    frame_dig -6
    frame_dig -5
    b^
    // bytes_ops/contract.py:37
    // assert result == bitwise_xor
    frame_dig -2
    ==
    assert
    // bytes_ops/contract.py:38
    // result = left & right
    frame_dig -6
    frame_dig -5
    b&
    // bytes_ops/contract.py:39
    // assert result == bitwise_and
    frame_dig -1
    ==
    assert
    retsub


// test_cases.bytes_ops.contract.do_augmented_assignment_ops(seed: bytes) -> void:
do_augmented_assignment_ops:
    // bytes_ops/contract.py:42-43
    // @subroutine
    // def do_augmented_assignment_ops(seed: Bytes) -> None:
    proto 1 0
    b do_augmented_assignment_ops_block@0

do_augmented_assignment_ops_block@0:
    // bytes_ops/contract.py:44
    // seed &= Bytes.from_hex("00")
    frame_dig -1
    pushbytes 0x00
    b&
    dup
    frame_bury -1
    // bytes_ops/contract.py:46
    // assert seed == Bytes.from_hex("00")
    pushbytes 0x00
    ==
    assert
    // bytes_ops/contract.py:50
    // seed |= five
    frame_dig -1
    // bytes_ops/contract.py:48
    // five = Bytes.from_hex("05")
    bytec_0 // 0x05
    // bytes_ops/contract.py:50
    // seed |= five
    b|
    dup
    frame_bury -1
    // bytes_ops/contract.py:48
    // five = Bytes.from_hex("05")
    bytec_0 // 0x05
    // bytes_ops/contract.py:52
    // assert seed == five
    ==
    assert
    // bytes_ops/contract.py:56
    // seed ^= sixteen
    frame_dig -1
    // bytes_ops/contract.py:54
    // sixteen = Bytes.from_hex("10")
    pushbytes 0x10
    // bytes_ops/contract.py:56
    // seed ^= sixteen
    b^
    dup
    frame_bury -1
    // bytes_ops/contract.py:58
    // assert seed == Bytes.from_hex("15")
    pushbytes 0x15
    ==
    assert
    // bytes_ops/contract.py:60
    // seed ^= five
    frame_dig -1
    // bytes_ops/contract.py:48
    // five = Bytes.from_hex("05")
    bytec_0 // 0x05
    // bytes_ops/contract.py:60
    // seed ^= five
    b^
    dup
    frame_bury -1
    // bytes_ops/contract.py:54
    // sixteen = Bytes.from_hex("10")
    pushbytes 0x10
    // bytes_ops/contract.py:62
    // assert seed == sixteen
    ==
    assert
    // bytes_ops/contract.py:64
    // seed += five
    frame_dig -1
    // bytes_ops/contract.py:48
    // five = Bytes.from_hex("05")
    bytec_0 // 0x05
    // bytes_ops/contract.py:64
    // seed += five
    concat
    dup
    frame_bury -1
    // bytes_ops/contract.py:66
    // assert seed == Bytes.from_hex("1005")
    pushbytes 0x1005
    ==
    assert
    retsub


// test_cases.bytes_ops.contract.do_byteops_with_structs(a: bytes, b: bytes) -> bytes, bytes:
do_byteops_with_structs:
    // bytes_ops/contract.py:72-73
    // @subroutine()
    // def do_byteops_with_structs(a: Point, b: Point) -> None:
    proto 2 2
    b do_byteops_with_structs_block@0

do_byteops_with_structs_block@0:
    frame_dig -2
    frame_dig -1
    // bytes_ops/contract.py:74
    // assert op.concat(a, b) == (a.bytes + b.bytes)
    frame_dig -2
    frame_dig -1
    concat
    frame_dig -2
    frame_dig -1
    concat
    ==
    assert
    retsub
